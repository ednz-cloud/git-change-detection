{
  "playbooks/bootstrap.yml": {
    "depends_on": [],
    "triggers": {
      "ansible/playbooks": ["bootstrap.yml", "tasks/crowdsec.yml"],
      "sops": ["keypair.secret.json"]
    }
  },
  "playbooks/k3s_cluster.yml": {
    "depends_on": ["playbooks/bootstrap.yml"],
    "triggers": {
      "ansible/playbooks": ["k3s_cluster.yml"]
    },
    "annotations": {
      "owner": "platform",
      "timeout": 600,
      "inventory": {"groups": ["k3s_servers", "k3s_agents"]}
    }
  },
  "blacklist": [
    "playbooks/netbird_controller.yml"
  ]
}
